{
  "name": "testowanie-oprogramowania-konopka",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikacja list zakupów i zestawy testów na laboratorium Testowanie Oprogramowania.",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:system": "node --test tests/system.test.js",
    "test:security": "node --test tests/security.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "perf": "node performance/load-test.js",
    "security:check": "node security/security-check.js"
  },
  "engines": { "node": ">=20" }
}
